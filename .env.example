# Copy to .env and adjust. Every value is optional except the PIN, if your bar
# has one set. All of these can equally be passed as environment variables, and
# docker compose reads this file directly.

# --- Destination device ---
# Hostname or IP of the BUSY Bar to drive. 10.0.4.20 is the fixed USB address;
# use busybar.local or the LAN IP to drive one over Wi-Fi.
BAROMETER_BUSYBAR_HOST=10.0.4.20
# Device API PIN. Required when the bar's HTTP access mode is "key".
BAROMETER_BUSYBAR_TOKEN=
# Draw priority: built-in apps are 10, an active BUSY session is 90.
BAROMETER_DRAW_PRIORITY=60

# --- Source API ---
# IANA timezone for the verdict. Leave blank to use the API's own default.
BAROMETER_TIMEZONE=Europe/Berlin

# --- Presentation ---
# fit    = shrink and wrap so the whole message is on screen at once (default).
#          Messages too tall even for the smallest font scroll downwards.
# scroll = keep the message on one line and marquee it sideways.
BAROMETER_DISPLAY_MODE=fit
# Seconds a too-tall message is held still before it starts scrolling down,
# so it can actually be read. Only used in fit mode.
BAROMETER_READ_PAUSE_SECONDS=3.0
BAROMETER_COLOR_GO=#00B000FF
BAROMETER_COLOR_STOP=#C00000FF
BAROMETER_COLOR_TEXT=#000000FF
# Seconds the verdict stays up. 0 keeps it until something replaces it.
BAROMETER_DISPLAY_SECONDS=60
BAROMETER_SOUND_ENABLED=true

# --- Discovery ---
# Publishes deploy-barometer.local so you can curl it by name. Has no effect
# inside a container -- run scripts/announce.py on the host for that.
BAROMETER_MDNS_ENABLED=true
BAROMETER_MDNS_NAME=deploy-barometer
# Address to advertise. Blank auto-detects this machine's LAN IP.
BAROMETER_MDNS_ADDRESS=

# --- Server ---
# 0.0.0.0 exposes the API on your machine's LAN IP, not just localhost.
BAROMETER_HOST=0.0.0.0
BAROMETER_PORT=2323
